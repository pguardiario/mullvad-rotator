# Copy to .env and fill in. Never commit .env.

# Mullvad WireGuard credentials (see README "Get a WireGuard key").
WIREGUARD_PRIVATE_KEY=
# The IPv4 address Mullvad assigned to the key, with /32.
WIREGUARD_ADDRESSES=10.x.x.x/32

# Shared proxy password. Generate with: openssl rand -hex 24
PROXY_PASSWORD=

# Optional
# ENTRY_COUNTRY=Sweden        # country of the tunnel's own entry relay (gluetun name)
# PROXY_PORT=8899             # host port, always bound to 127.0.0.1
# PROXY_USER=user             # fixed username prefix
# STICKY_TTL_MIN=30
# RELAY_COOLDOWN_MIN=10
# HEALTHCHECK_INTERVAL_MIN=15 # 0 disables the background exit check
# LOG_LEVEL=info              # debug|info|warn|error
# TZ=UTC
